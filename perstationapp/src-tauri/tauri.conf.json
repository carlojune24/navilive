{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESP32 Wiegand RFID Reader",
  "version": "0.1.0",
  "identifier": "com.carlo.esp32wiegandrfidreader",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev:web", "beforeBuildCommand": "npm run build:web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Race Tracker - ESP32 RFID", "width": 1320, "height": 840, "minWidth": 1000, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}

