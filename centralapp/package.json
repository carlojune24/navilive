{
	"name": "centralapp",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:e2e": "node --test e2e/station-api.e2e.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate.ps1",
		"deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.57.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"bits-ui": "^2.19.5",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/barlow-semi-condensed": "^5.3.0",
		"@fontsource/big-shoulders-display": "^5.3.0",
		"clsx": "^2.1.1",
		"maplibre-gl": "^5.24.0",
		"pg": "^8.23.1",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	}
}
